{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": ["--require", "ts-node/register", "server/index.ts"],
      "port": 3001,
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin",
        "NODE_PATH": "server/node_modules",
        "TS_NODE_PROJECT": "server/tsconfig.json"
      }
    },
    {
      "name": "frontend",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": ["node_modules/.bin/vite"],
      "port": 5173,
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    }
  ]
}
